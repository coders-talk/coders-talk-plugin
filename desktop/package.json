{
    "name": "coders-talk-desktop",
    "productName": "Coders Talk",
    "version": "0.1.1",
    "private": true,
    "description": "Coders Talk",
    "author": "Coders Talk",
    "homepage": "https://coders.talk",
    "license": "MIT",
    "type": "module",
    "main": "main.mjs",
    "scripts": {
        "start": "electron .",
        "stage-cli": "node scripts/stage-cli.mjs",
        "dist": "node scripts/stage-cli.mjs && electron-builder --publish never",
        "test": "node --test \"test/*.test.mjs\"",
        "dist:store": "node scripts/dist-store.mjs"
    },
    "devDependencies": {
        "electron": "44.5.1",
        "electron-builder": "26.15.3"
    },
    "build": {
        "appId": "talk.coders.desktop",
        "productName": "Coders Talk",
        "artifactName": "coders-talk-desktop-${version}-${os}-${arch}.${ext}",
        "directories": {
            "output": "out"
        },
        "files": [
            "main.mjs",
            "preload.cjs",
            "src/**",
            "package.json",
            "build/icon.png"
        ],
        "extraResources": [
            {
                "from": "resources/bin/${os}-${arch}",
                "to": "bin"
            }
        ],
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "category": "public.app-category.developer-tools",
            "hardenedRuntime": true
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "artifactName": "Coders-Talk-Setup-${version}.${ext}",
            "shortcutName": "Coders Talk",
            "uninstallDisplayName": "Coders Talk",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "runAfterFinish": true,
            "deleteAppDataOnUninstall": false
        },
        "icon": "build/icon.png",
        "copyright": "Copyright © 2026 Coders Talk",
        "publish": [
            {
                "provider": "github",
                "owner": "coders-talk",
                "repo": "coders-talk-plugin",
                "releaseType": "release"
            }
        ],
        "appx": {
            "identityName": "CoderTalk.CodersTalk",
            "publisher": "CN=93767D7D-2F6C-4773-88E4-0F34AE38E642",
            "publisherDisplayName": "Coder Talk",
            "applicationId": "CodersTalk",
            "displayName": "Coders Talk",
            "backgroundColor": "#F8F7F3",
            "languages": [
                "en-US"
            ],
            "minVersion": "10.0.17763.0",
            "artifactName": "Coders-Talk-${version}-store.${ext}",
            "maxVersionTested": "10.0.26100.0"
        }
    },
    "dependencies": {
        "electron-updater": "^6.8.9"
    }
}
