{
    "description": "Remembers the git HEAD at the start of a session, so /coders-talk:build can list the session's commits. When auto mode is on for this computer (/coders-talk:auto), sends the session in the background while it runs (every ten minutes of work), when it ends, and at the next start if it never said it ended; otherwise sends nothing.",
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop.mjs\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.mjs\"",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
